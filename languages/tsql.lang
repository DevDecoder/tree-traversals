[preorder]
CREATE OR ALTER PROCEDURE Preorder(@rootId INT) AS
BEGIN
    WITH preorder_traversal AS (
        [enter]SELECT id, val, [nary]parent_id[/nary][!nary]left_id, [ternary]middle_id, [/ternary]right_id[/!nary], 1 AS ord[/enter]
        FROM tree WHERE id = @rootId

        UNION ALL

        SELECT t.id, t.val, [nary]t.parent_id[/nary][!nary]t.left_id, [ternary]t.middle_id, [/ternary]t.right_id[/!nary],
               pt.ord + 1
        FROM tree t
        JOIN preorder_traversal pt ON [nary]
            [move:next]t.parent_id = pt.id[/move:next][/nary][!nary]
            [move:left]t.id = pt.left_id[/move:left] OR [ternary]
            [move:middle]t.id = pt.middle_id[/move:middle] OR [/ternary]
            [move:right]t.id = pt.right_id[/move:right][/!nary]
    )
    [visit]SELECT val FROM preorder_traversal ORDER BY ord;[/visit]
END;
GO
[/preorder]

