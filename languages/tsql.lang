[postorder]
CREATE OR ALTER PROCEDURE Postorder(@rootId INT) AS
BEGIN
    WITH postorder_traversal AS (
        [enter]SELECT id, val, [nary]parent_id[/nary][!nary]left_id, [ternary]middle_id, [/ternary]right_id[/!nary], 1 AS depth[/enter]
        FROM tree WHERE id = @rootId
        UNION ALL
        SELECT t.id, t.val, [nary]t.parent_id[/nary][!nary]t.left_id, [ternary]t.middle_id, [/ternary]t.right_id[/!nary], pt.depth + 1
        FROM tree t
        JOIN postorder_traversal pt ON [nary]
            [move:next]t.parent_id = pt.id[/move:next][/nary][!nary]
            [move:left]t.id = pt.left_id[/move:left] OR [ternary]
            [move:middle]t.id = pt.middle_id[/move:middle] OR [/ternary]
            [move:right]t.id = pt.right_id[/move:right][/!nary]
    )
    [visit]SELECT val FROM postorder_traversal ORDER BY depth DESC;[/visit]
END;
GO
[/postorder]

DECLARE @mode VARCHAR(10) = '{{mode}}';
IF @mode = 'PRE' EXEC Preorder {{rootValue}};
ELSE IF @mode = 'POST' EXEC Postorder {{rootValue}};
