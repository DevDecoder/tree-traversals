[nary]import java.util.*;[/nary]

class Node {
    int value;
    [nary]List<Node> children;[/nary][!nary]Node left, right;[/!nary][ternary]
    Node middle;[/ternary]

    Node(int value[nary], List<Node> children[/nary][!nary], Node left[/!nary][ternary], Node middle[/ternary][!nary], Node right[/!nary]) {
        this.value = value;
        [nary]this.children = children;[/nary][!nary]this.left = left;
        this.right = right;[/!nary][ternary]
        this.middle = middle;[/ternary]
    }
}

public class Main {

[preorder]
    static void preOrder(Node node) {
        [enter]if (node == null) return;[/enter]
        [visit]System.out.println(node.value);[/visit]
        [nary]for (Node child : node.children) {
            [move:next]preOrder(child);[/move:next]
        }[/nary][!nary][move:left]preOrder(node.left);[/move:left][ternary]
        [move:middle]preOrder(node.middle);[/move:middle][/ternary]
        [move:right]preOrder(node.right);[/move:right][/!nary]
    }
[/preorder]

[inorder]
    static void inOrder(Node node) {
        [enter]if (node == null) return;[/enter]
        [move:left]inOrder(node.left);[/move:left]
        [visit]System.out.println(node.value);[/visit]
        [move:right]inOrder(node.right);[/move:right]
    }
[/inorder]

[postorder]
    static void postOrder(Node node) {
        [enter]if (node == null) return;[/enter]
        [nary]for (Node child : node.children) {
            [move:next]postOrder(child);[/move:next]
        }[/nary][!nary][move:left]postOrder(node.left);[/move:left][ternary]
        [move:middle]postOrder(node.middle);[/move:middle][/ternary]
        [move:right]postOrder(node.right);[/move:right][/!nary]
        [visit]System.out.println(node.value);[/visit]
    }
[/postorder]

    public static void main(String[] args) {
        Node root = {{nestedTree}};
        String mode = "{{mode}}";

        if (mode.equals("PRE")) preOrder(root);
        else if (mode.equals("IN")) inOrder(root);
        else if (mode.equals("POST")) postOrder(root);
    }
}
